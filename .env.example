# Environment Configuration for SkillNexus

# PostgreSQL
POSTGRES_USER=skillnexus
POSTGRES_PASSWORD=skillnexus_secret
POSTGRES_DB=skillnexus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://skillnexus:skillnexus_secret@localhost:5432/skillnexus_db

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillnexus_secret
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=skillnexus_admin
MINIO_ROOT_PASSWORD=skillnexus_minio_secret
MINIO_BUCKET_RESUMES=skillnexus-resumes
MINIO_SECURE=false

# LLM APIs
GEMINI_API_KEY=your_gemini_api_key_here
QWEN_VLLM_BASE_URL=http://localhost:8000/v1

# Security & App
SECRET_KEY=skillnexus_super_secret_development_key_change_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
LOG_LEVEL=INFO
